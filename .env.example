# Copia este archivo como .env y completa los valores.
BACKEND_URL=https://TU-BACKEND.onrender.com
# El mismo valor de AI_API_KEY que tiene el backend. Nunca lo pongas en el frontend.
AI_API_KEY=

# Gestor de camara (camara/). Minimo 32 caracteres; sin esta clave el servicio no arranca.
CAMERA_API_KEY=
# Opcionales. CORS_ORIGINS va en formato JSON y no admite "*".
# FFMPEG_PATH=ffmpeg
# MEDIAMTX_RTSP=rtsp://127.0.0.1:8554
# MEDIAMTX_HLS=http://127.0.0.1:8888
# CONFIG_PATH=config.json
# MAX_CAMARAS=8
# CORS_ORIGINS=["http://localhost:5173"]
